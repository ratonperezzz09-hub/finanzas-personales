{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil privado y estado de configuración inicial de un usuario autenticado en Mi Presupuesto Mensual.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Identificador único de Firebase Auth del propietario."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Nombre visible del usuario."
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "format": "email",
          "description": "Correo electrónico de la cuenta."
        },
        "hasCompletedOnboarding": {
          "type": "boolean",
          "description": "Indica si el usuario ya respondió la pregunta inicial de presupuesto mensual."
        },
        "defaultMonthlyBudget": {
          "type": "number",
          "description": "Presupuesto mensual base en pesos colombianos (COP)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha de creación establecida por el servidor."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha de última actualización establecida por el servidor."
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "hasCompletedOnboarding",
        "defaultMonthlyBudget",
        "createdAt",
        "updatedAt"
      ]
    },
    "MonthlyBudget": {
      "title": "MonthlyBudget",
      "description": "Configuración de presupuesto mensual por mes para una cuenta específica.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID del propietario."
        },
        "id": {
          "type": "string",
          "minLength": 7,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Identificador del mes (ej. 2026-11)."
        },
        "monthLabel": {
          "type": "string",
          "minLength": 3,
          "maxLength": 20,
          "description": "Nombre del mes en español."
        },
        "year": {
          "type": "number",
          "description": "Año calendario."
        },
        "totalDays": {
          "type": "number",
          "description": "Cantidad de días del mes."
        },
        "currentDay": {
          "type": "number",
          "description": "Día actual o máximo con movimientos registrados."
        },
        "monthlyBudget": {
          "type": "number",
          "description": "Presupuesto mensual base en COP."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca temporal de creación."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca temporal de actualización."
        }
      },
      "required": [
        "uid",
        "id",
        "monthLabel",
        "year",
        "totalDays",
        "currentDay",
        "monthlyBudget",
        "createdAt",
        "updatedAt"
      ]
    },
    "Movement": {
      "title": "Movement",
      "description": "Gasto o ingreso registrado por el usuario dentro de un mes.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID del propietario."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Identificador único del movimiento."
        },
        "monthId": {
          "type": "string",
          "minLength": 7,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Mes al que pertenece el movimiento (ej. 2026-11)."
        },
        "kind": {
          "type": "string",
          "enum": ["expense", "income"],
          "description": "Tipo de movimiento."
        },
        "day": {
          "type": "number",
          "description": "Día del mes (1-31)."
        },
        "dateLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Etiqueta corta de fecha."
        },
        "fullDateLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Etiqueta completa de fecha."
        },
        "timeLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "description": "Hora del registro."
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Categoría del gasto o ingreso."
        },
        "concept": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Descripción o concepto del movimiento."
        },
        "amount": {
          "type": "number",
          "description": "Monto en pesos colombianos (COP), mayor que cero."
        },
        "createdAtMs": {
          "type": "number",
          "description": "Timestamp numérico en milisegundos para ordenamiento."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca temporal del servidor."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca temporal de última edición establecida por el servidor."
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Observaciones opcionales."
        },
        "isoDate": {
          "type": "string",
          "maxLength": 20,
          "description": "Fecha ISO opcional para ingresos."
        },
        "paymentMethod": {
          "type": "string",
          "maxLength": 40,
          "description": "Medio de pago opcional para ingresos."
        }
      },
      "required": [
        "uid",
        "id",
        "monthId",
        "kind",
        "day",
        "dateLabel",
        "fullDateLabel",
        "timeLabel",
        "category",
        "concept",
        "amount",
        "createdAtMs",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Perfil privado del usuario y estado de onboarding."
    },
    "/users/{userId}/months/{monthId}": {
      "schema": {
        "$ref": "#/entities/MonthlyBudget"
      },
      "description": "Presupuestos mensuales privados de cada usuario."
    },
    "/users/{userId}/movements/{movementId}": {
      "schema": {
        "$ref": "#/entities/Movement"
      },
      "description": "Gastos e ingresos privados registrados por cada usuario."
    }
  }
}
